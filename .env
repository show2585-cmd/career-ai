# 공개 설정 (커밋 대상). 비밀 값은 .env.local 또는 Vercel 환경 변수에 둔다.
#
# 배포 도메인: canonical, OG, sitemap의 절대 URL에 쓰인다.
# 비워두면 Vercel에서는 프로덕션 도메인(VERCEL_PROJECT_PRODUCTION_URL)을 자동으로 쓴다.
# 커스텀 도메인을 연결하면 Vercel 환경 변수에 VITE_SITE_URL=https://내도메인 을 추가하세요.
# VITE_SITE_URL=

# Google Analytics 4 측정 ID (공개 값). 배포 사이트에서만 수집하고 localhost는 제외한다.
VITE_GA_ID=G-ZBJQWYWWQ0
